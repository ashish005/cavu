# Server for ./ftp.sh <env>. Copy to .env.deploy.<env> (e.g. .env.deploy.production; git-ignored) and fill in.
# Kept apart from .env.<env>, which is uploaded with the app: this login must never be.

FTP_HOST=CHANGE_ME
FTP_USER=CHANGE_ME

# sftp (SSH key, recommended) | ftp (FTP / FTPS)
FTP_PROTOCOL=sftp
FTP_PORT=22

# SFTP: private key and the expected fingerprints (SHA256:...), verified before connecting
FTP_KEY=~/.ssh/CHANGE_ME
FTP_KEY_FINGERPRINT=
FTP_HOST_FINGERPRINT=

# FTP / FTPS only
FTP_PASSWORD=
# explicit (FTPES, port 21, recommended) | implicit (FTPS, port 990) | none (plain FTP, unencrypted)
FTP_SECURE=explicit
FTP_PASSIVE=true
FTP_INSECURE_TLS=false

# Server folder (from the login's root) for each release in releases.conf: FTP_<NAME>_DIR
FTP_FRONTEND_DIR=CHANGE_ME
